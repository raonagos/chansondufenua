# ---------------------------------------------------------------------------
# Chanson du fenua v4 — environment template
# ---------------------------------------------------------------------------
# This file is a *reference*, not something the binary reads. There is no dotenv
# loader, so nothing here is picked up on its own: export the variables, or put
# them on the command line.
#
#   export DATABASE_URL=sqlite://data/chansondufenua.db
#   ./target/debug/chansondufenua
#
# ...or in one shot:
#
#   DATABASE_URL=sqlite://data/chansondufenua.db ./target/debug/chansondufenua
#
# Four variables exist today. Anything else the site needs in future gets added
# here, never guessed at.
#
# Remember the asset bundle, or the binary panics at startup:
#   cargo build && topcoat asset bundle && ./target/debug/chansondufenua
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# SQLite URL. A relative path resolves from the working directory.
#
# The file does not have to exist. On every boot the binary creates the parent
# directory, creates the database, and applies everything in `migrations/`.
# Deleting the file is how you start over.
#
#   sqlite://data/chansondufenua.db   on disk (default)
#   sqlite::memory:                   throwaway, nothing persisted
#
# Unset, this defaults to the value below.
DATABASE_URL=sqlite://data/chansondufenua.db

# --- HTTP ------------------------------------------------------------------
# Read by `topcoat::start`. Unset, they default to 127.0.0.1 and 3000.
#
# Ports 80 and 443 need privileges this account does not have, so a reverse
# proxy goes in front for those.
HOST=127.0.0.1
PORT=3000

# --- Translations ----------------------------------------------------------
# Where the chrome's words are read from at startup: `fr.toml`, `ty.toml` and
# `en.toml`, a flat `name = "words"` table each. Read at runtime, never
# compiled, so correcting a sentence is an edit and a restart.
#
# Unset, the binary looks in `./locales` and then in `locales/` beside the
# executable — a deployment can ship the directory next to the binary.
#
# Set, this is the ONLY directory tried: a typo here is a boot error, not a
# quiet fall-through to another copy.
LOCALES_DIR=locales
